---
export interface Props { collapsible?: boolean }
const { collapsible = false } = Astro.props;
---
<ul class:list={["arrow-list", { collapsible }]}><slot /></ul>

<style>
  :global(.arrow-list) {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--font-size-subtitle);
    width: 100%;
  }

  :global(.arrow-list li) {
    margin: 4px 0;
    opacity: 0.85;
  }

  /* Non-collapsible lists get hollow arrows */
  :global(.arrow-list:not(.collapsible) li)::before {
    content: "▹";
    margin-right: 4px;
  }

  /* Items without children get outline arrows */
  :global(.arrow-list.collapsible li:not(.has-children)) {
    cursor: default;
  }

  :global(.arrow-list.collapsible li:not(.has-children))::before {
    content: "▹";
    margin-right: 4px;
  }

  /* Items with children get filled arrows */
  :global(.arrow-list.collapsible li.has-children) {
    cursor: default;
  }

  :global(.arrow-list.collapsible li.has-children .item-label) {
    cursor: pointer;
    display: inline;
  }

  :global(.arrow-list.collapsible li.has-children)::before {
    content: "▸ ";
    margin-right: 4px;
    display: inline-block;
    transition: transform 0.3s ease;
    cursor: pointer !important;
  }

  :global(.arrow-list.collapsible li.expanded.has-children)::before {
    transform: rotate(90deg);
  }

  /* Nested items without children also get outline arrows */
  :global(.arrow-list.collapsible .arrow-list li:not(.has-children)) {
    cursor: default;
  }

  :global(.arrow-list.collapsible .arrow-list li:not(.has-children))::before {
    content: "▹";
    margin-right: 4px;
  }

  /* Nested items with children get filled arrows */
  :global(.arrow-list.collapsible .arrow-list li.has-children) {
    cursor: default !important;
  }

  :global(.arrow-list.collapsible .arrow-list li.has-children .item-label) {
    cursor: pointer !important;
    display: inline;
  }

  :global(.arrow-list.collapsible .arrow-list li.has-children)::before {
    content: "▸ ";
    margin-right: 4px;
    display: inline-block;
    transition: transform 0.3s ease;
    cursor: pointer !important;
  }

  /* Style nested lists - they inherit collapsible behavior */
  :global(.arrow-list.collapsible li > ul.arrow-list) {
    margin: 4px 0 0 20px;
    display: none;
  }

  :global(.arrow-list.collapsible li.expanded > ul.arrow-list) {
    display: block;
  }

  /* Nested list items also clickable if they have children */
  :global(.arrow-list.collapsible .arrow-list li.has-children) {
    cursor: pointer;
  }

  :global(.arrow-list.collapsible .arrow-list li.has-children)::before {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  :global(.arrow-list.collapsible .arrow-list li.expanded.has-children)::before {
    transform: rotate(90deg);
  }
</style>

{collapsible && (
  <script>
    function enhanceBulletLists() {
      // Enhance all collapsible arrow-lists once
      document.querySelectorAll('.arrow-list.collapsible').forEach((root) => {
        if (root instanceof HTMLElement === false) return;

        // Guard so multiple component instances don't re-bind
        if (root.dataset.enhanced === '1') return;
        root.dataset.enhanced = '1';

        // Wrap text content in spans for clickable area control
        root.querySelectorAll('li.has-children').forEach((li) => {
          // Check if already wrapped
          if (li.querySelector('.item-label')) return;

          // Get direct text nodes only (not from nested elements)
          const textNodes = Array.from(li.childNodes).filter(
            node => node.nodeType === Node.TEXT_NODE && node.textContent.trim()
          );

          if (textNodes.length > 0) {
            textNodes.forEach(textNode => {
              const span = document.createElement('span');
              span.className = 'item-label';
              span.textContent = textNode.textContent;
              li.replaceChild(span, textNode);
            });
          }
        });

        // Toggle expand/collapse - handle clicks on any level
        root.addEventListener('click', (e) => {
          if (!(e.target instanceof Element)) return;

          // Only respond to clicks on item labels
          const isLabelClick = e.target.classList.contains('item-label');

          // Also check if clicking on the li itself near the arrow (::before pseudo-element)
          // The arrow is roughly 20px wide (icon + margin)
          let isArrowClick = false;
          if (e.target.tagName === 'LI' && e.target.classList.contains('has-children')) {
            const rect = e.target.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            isArrowClick = clickX < 20; // Arrow is within first 20px
          }

          if (!isLabelClick && !isArrowClick) return;

          const li = e.target.closest('li.has-children');
          if (!li || !root.contains(li)) return;

          // Only toggle if this is the closest has-children li to the click
          const clickedLi = e.target.closest('li');
          if (clickedLi !== li) return;

          e.stopPropagation();
          li.classList.toggle('expanded');
        });
      });
    }

    // Run on initial load and after every view transition
    enhanceBulletLists();
    document.addEventListener('astro:after-swap', () => {
      // Clear enhancement flags before re-initializing
      document.querySelectorAll('.arrow-list.collapsible').forEach((root) => {
        if (root instanceof HTMLElement) {
          root.dataset.enhanced = '0';
        }
      });
      enhanceBulletLists();
    });
  </script>
)}
