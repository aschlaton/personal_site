---
// Single source of truth for color values
// These must be defined inline in <head> before scripts run
---
<style is:inline>
  :root {
    --color-black: #1F1F28;
    --color-white: #EFF1F5;
    --color-fg-dark: #DCD7BA;
    --color-fg-light: #4C4F69;
    --color-bg: #EFF1F5;
    --color-fg: #4C4F69;
    --color-link-light: #1E66F5;
    --color-link-dark: #7E9CD8;
    --color-link: #1E66F5;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.15s;
  }
</style>
