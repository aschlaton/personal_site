---
// Single source of truth for color values
// These must be defined inline in <head> before scripts run
---
<style is:inline>
  :root {
    --color-black: #2a2a2a;
    --color-white: #cdcdcd;
    --color-bg: #cdcdcd;
    --color-fg: #2a2a2a;
    --color-link-light: #3d5dc3;
    --color-link-dark: #b8a8ff;
    --color-link: #6a5dd3;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
