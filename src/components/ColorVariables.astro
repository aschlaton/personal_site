---
// Single source of truth for color values
// These must be defined inline in <head> before scripts run
---
<style is:inline>
  :root {
    --color-background-dark: #181820;
    --color-background-light: #EFF1F5;
    --color-fg-dark: #DCD7BA;
    --color-fg-light: #4C4F69;
    --color-subtitle-dark: #76946A;
    --color-subtitle-light: #209FB5;
    --color-muted-dark: #727169;
    --color-muted-light: #8C8FA1;
    --color-divider-dark: #938AA9;
    --color-divider-light: #7287FD;
    --color-border-dark: #658594;
    --color-border-light: #DC8A78;
    --color-bg: #EFF1F5;
    --color-fg: #4C4F69;
    --color-subtitle: #209FB5;
    --color-muted: #8C8FA1;
    --color-divider: #7287FD;
    --color-border: #DC8A78;
    --color-link-light: #1E66F5;
    --color-link-dark: #7E9CD8;
    --color-link: #1E66F5;
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.15s;
  }
</style>
