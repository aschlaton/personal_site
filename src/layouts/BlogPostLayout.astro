---
import PageLayout from "./PageLayout.astro";

export interface Props {
  frontmatter: {
    title: string;
    date: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;

// Extract slug from URL pathname
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || '';
---

<PageLayout title={frontmatter.title} subtitle={frontmatter.date} filepath={`~/blog/${slug}`}>
  <article class="blog-post">
    <slot />
  </article>
</PageLayout>

<style>
  .blog-post :global(h1) {
    font-size: 1.5rem;
    margin: 1em 0 0.5em 0;
  }

  .blog-post :global(h2) {
    font-size: 1.25rem;
    margin: 1em 0 0.5em 0;
  }

  .blog-post :global(h3) {
    font-size: 1.1rem;
    margin: 1em 0 0.5em 0;
  }

  .blog-post :global(p) {
    margin: 0.75em 0;
  }

  .blog-post :global(ul), .blog-post :global(ol) {
    margin: 0.75em 0;
    padding-left: 1.5em;
  }

  .blog-post :global(li) {
    margin: 0.25em 0;
  }

  .blog-post :global(code) {
    font-family: monospace;
    background: rgba(0, 0, 0, 0.05);
    padding: 0.2em 0.4em;
    border-radius: 3px;
  }

  .blog-post :global(pre) {
    background: rgba(0, 0, 0, 0.05);
    padding: 1em;
    border-radius: 3px;
    overflow-x: auto;
    font-size: 0.85rem;
  }

  .blog-post :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .blog-post :global(blockquote) {
    border-left: 3px solid var(--color-fg);
    padding-left: 1em;
    margin: 1em 0;
    opacity: 0.8;
  }

  .blog-post :global(a) {
    color: var(--color-link);
    text-decoration: none;
  }

  .blog-post :global(a:hover) {
    text-decoration: underline;
  }

  .blog-post :global(.footnotes h2) {
    display: none;
  }

  .blog-post :global(.footnotes) {
    border-top: 1px solid var(--color-divider);
    color: var(--color-muted);
    margin-top: 1.5em;
    padding-top: 0.75em;
  }
</style>

<script>
  function initFootnoteSmoothScroll() {
    const blogPost = document.querySelector('.blog-post');
    if (!(blogPost instanceof HTMLElement)) return;
    if (blogPost.dataset.footnoteSmoothInit === '1') return;
    blogPost.dataset.footnoteSmoothInit = '1';

    blogPost.addEventListener('click', (event) => {
      const clicked = event.target;
      if (!(clicked instanceof Element)) return;

      const link = clicked.closest('a[data-footnote-ref], a[data-footnote-backref], a[href^="#fn"], a[href^="#fnref"]');
      if (!(link instanceof HTMLAnchorElement)) return;

      const targetHash = link.hash;
      if (!targetHash) return;
      const targetId = decodeURIComponent(targetHash.slice(1));
      const targetElement = document.getElementById(targetId);
      if (!(targetElement instanceof HTMLElement)) return;

      event.preventDefault();
      targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.pushState(null, '', targetHash);
    });
  }

  initFootnoteSmoothScroll();
  document.addEventListener('astro:after-swap', initFootnoteSmoothScroll);
</script>
