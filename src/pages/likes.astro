      <ul class="arrow-list">
        <li class="has-children">Fiction
          <ul class="arrow-list">
            <li>The Road - Cormac McCarthy</li>
            <li>1984 - George Orwell</li>
            <li>Beloved - Toni Morrison</li>
            <li>Infinite Jest - David Foster Wallace</li>
            <li>The Goldfinch - Donna Tartt</li>
            <li>Never Let Me Go - Kazuo Ishiguro</li>
            <li>Station Eleven - Emily St. John Mandel</li>
            <li>The Amazing Adventures of Kavalier & Clay - Michael Chabon</li>
          </ul>
        </li>
        <li class="has-children">Non-Fiction
          <ul class="arrow-list">
            <li>Sapiens - Yuval Noah Harari</li>
            <li>Educated - Tara Westover</li>
            <li>Thinking, Fast and Slow - Daniel Kahneman</li>
            <li>The Sixth Extinction - Elizabeth Kolbert</li>
            <li>Guns, Germs, and Steel - Jared Diamond</li>
          </ul>
        </li>
      </ul>
    </li>
    <li class="has-children">Music
      <ul class="arrow-list">
        <li class="has-children">Artists
          <ul class="arrow-list">
            <li>Radiohead</li>
            <li>Bon Iver</li>
            <li>Sufjan Stevens</li>
            <li>Fleet Foxes</li>
            <li>The National</li>
            <li>Arcade Fire</li>
            <li>Modest Mouse</li>
            <li>LCD Soundsystem</li>
            <li>Phoebe Bridgers</li>
            <li>Death Cab for Cutie</li>
            <li>Sigur Rós</li>
            <li>Vampire Weekend</li>
          </ul>
        </li>
        <li class="has-children">Albums
          <ul class="arrow-list">
            <li>In Rainbows - Radiohead</li>
            <li>For Emma, Forever Ago - Bon Iver</li>
            <li>Illinois - Sufjan Stevens</li>
            <li>Funeral - Arcade Fire</li>
            <li>Sound of Silver - LCD Soundsystem</li>
            <li>The Moon & Antarctica - Modest Mouse</li>
            <li>Helplessness Blues - Fleet Foxes</li>
