      </ul>
    </li>
    <li class="has-children">games
      <ul class="arrow-list">
        <li>hearthstone</li>
        <li>hades II</li>
        <li>slay the spire</li>
        <li>football manager</li>
        <li>clash royale</li>
      </ul>
    </li>
    <li class="has-children">sports
      <ul class="arrow-list">
        <li>philadelphia eagles</li>
        <li>los angeles lakers</li>
        <li>lille osc</li>
      </ul>
