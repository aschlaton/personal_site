---
import PageLayout from "../layouts/PageLayout.astro";
import BulletList from "../components/BulletList.astro";
---

<PageLayout title="Things I Like" subtitle="I like these things." filepath="~/likes">
  <BulletList collapsible>
    <li class="has-children">Movies
      <ul class="arrow-list">
        <li class="has-children">Drama
          <ul class="arrow-list">
            <li>1917</li>
            <li>Asteroid City</li>
            <li>Small Things Like These</li>
            <li>The Shawshank Redemption</li>
            <li>Parasite</li>
            <li>Moonlight</li>
            <li>Manchester by the Sea</li>
            <li>Arrival</li>
            <li>There Will Be Blood</li>
            <li>No Country for Old Men</li>
          </ul>
        </li>
        <li class="has-children">Sci-Fi
          <ul class="arrow-list">
            <li>Blade Runner 2049</li>
            <li>Interstellar</li>
            <li>The Matrix</li>
            <li>Ex Machina</li>
            <li>Inception</li>
            <li>Her</li>
            <li>Annihilation</li>
            <li>Dune</li>
            <li>2001: A Space Odyssey</li>
          </ul>
        </li>
        <li class="has-children">Comedy
          <ul class="arrow-list">
            <li>The Grand Budapest Hotel</li>
            <li>In Bruges</li>
