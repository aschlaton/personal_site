---
import PageLayout from "../../layouts/PageLayout.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import { getCollection, render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";

export async function getStaticPaths() {
  const POSTS_PER_PAGE = 4;
  const getPostSlug = (post) => String(post.slug ?? post.id).replace(/\.md$/, "");
  const allPosts = (await getCollection("blog")).sort((a, b) =>
    b.data.date.localeCompare(a.data.date)
  );

  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
  const listingPaths = Array.from({ length: totalPages }, (_, i) => {
    const pageNum = i + 1;
    const start = i * POSTS_PER_PAGE;
    const posts = allPosts.slice(start, start + POSTS_PER_PAGE).map((post) => ({
      title: post.data.title,
      date: post.data.date,
      slug: getPostSlug(post),
      description: post.data.description,
    }));

    return {
      params: { page: pageNum.toString() },
      props: {
        kind: "listing",
        posts,
        currentPage: pageNum,
        totalPages,
      },
    };
  });

  const postPaths = allPosts.map((post) => ({
    params: { page: getPostSlug(post) },
    props: {
      kind: "post",
      post,
    },
  }));

  return [...listingPaths, ...postPaths];
}

const props = Astro.props;
const isPostPage = props.kind === "post";
const isListingPage = props.kind === "listing";
const post = isPostPage ? props.post : null;
const currentPage = isListingPage ? props.currentPage : 1;
const totalPages = isListingPage ? props.totalPages : 1;
const posts = isListingPage ? props.posts : [];
const renderedPost = post ? await render(post) : null;
---

{isPostPage && post && renderedPost ? (
  <BlogPostLayout
    frontmatter={{
      title: post.data.title,
      date: post.data.date,
      description: post.data.description,
    }}
  >
    <renderedPost.Content />
  </BlogPostLayout>
) : (
  <PageLayout title="Blog" subtitle="thoughts" filepath="~/blog">
    <div class="blog-content">
      {posts.map((blogPost) => (
        <BlogPostCard
          title={blogPost.title}
          date={blogPost.date}
          slug={blogPost.slug}
          description={blogPost.description}
        />
      ))}
    </div>

    <div class="pagination">
      {currentPage > 1 && (
        <a href={`/blog/${currentPage - 1}`} class="page-link">← Previous</a>
      )}
      <span class="page-info">Page {currentPage} of {totalPages}</span>
      {currentPage < totalPages && (
        <a href={`/blog/${currentPage + 1}`} class="page-link">Next →</a>
      )}
    </div>
  </PageLayout>
)}

<style>
  .blog-content {
    flex: 0 1 auto;
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--color-divider);
  }

  .page-link {
    color: var(--color-link);
    text-decoration: none;
    opacity: 0.85;
  }

  .page-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .page-info {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
</style>
